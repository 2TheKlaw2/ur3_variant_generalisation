Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (base, 10 mm cells)
      Enabled: true
      Reference Frame: base
      Plane: XY
      Plane Cell Count: 60
      Cell Size: 0.01
      Color: 160; 160; 164
      Alpha: 0.35
      Line Style:
        Value: Lines
    - Class: rviz_default_plugins/RobotModel
      Name: UR3e + RG2
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: V1-V5 scene (plates, parts, fittings)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /scene/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF (scene frames)
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.05
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Robot-side view of the plates
      Target Frame: base
      Focal Point:
        X: 0.0
        Y: -0.34
        Z: 0.02
      Distance: 0.75
      Pitch: 0.75
      Yaw: 1.5708
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
